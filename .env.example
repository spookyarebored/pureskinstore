# ===================================
# PureSkin Store — Configuration
# ===================================

# --- Discord Bot ---
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here
GUILD_ID=your_discord_guild_id_here

# --- Discord Roles & Channels ---
STAFF_ROLE_ID=your_staff_role_id_here
OWNER_ROLE_ID=your_owner_role_id_here
TICKET_CATEGORY_ID=your_ticket_category_id_here
LOG_CHANNEL_ID=your_log_channel_id_here

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/pureskin_store

# --- API Server ---
API_PORT=3001
API_URL=http://localhost:3001

# --- Web Panel ---
WEB_PORT=5173
WEB_URL=http://localhost:5173

# --- Discord OAuth2 ---
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
OAUTH2_REDIRECT_URI=http://localhost:3001/api/auth/callback

# --- Security ---
JWT_SECRET=generate_a_strong_random_secret_here_min_32_chars
SESSION_SECRET=generate_another_strong_random_secret_here
COOKIE_DOMAIN=localhost

# --- Encryption (for sensitive account data) ---
ENCRYPTION_KEY=generate_a_32_byte_hex_key_here_64_hex_chars
